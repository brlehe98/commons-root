{
  "name": "@commons-root/app",
  "description": "Commons",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@commons-root/gen-client": "file:./networking/gen/client",
    "@commons-root/gen-server": "file:./networking/gen/server",
    "@commons-root/gen-shared": "file:./networking/gen/shared",
    "@rootsdk/client-app": "0.21.3",
    "@rootsdk/server-app": "0.21.3"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "0.21.3",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "node clean.js",
    "postinstall": "node scripts/apply-patches.mjs",
    "package": "node scripts/package.mjs",
    "check:access": "node scripts/check-rpc-access.mjs",
    "upload": "node scripts/upload.mjs"
  },
  "workspaces": {
    "packages": [
      "./networking",
      "./server",
      "./client"
    ]
  },
  "overrides": {
    "@rootsdk/server-app": {
      "sqlite3": "6.0.1"
    },
    "uuid": "11.1.1"
  }
}
